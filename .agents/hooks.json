{
  "kapiert-pre-push-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/hook_runner.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
