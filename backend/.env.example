# Copy to backend/.env for local development:
#   cp .env.example .env

# Path to german-nouns CSV (optional — defaults to backend/nouns.csv)
NOUNS_CSV_PATH=backend/nouns.csv

# Server
HOST=0.0.0.0
PORT=8000
RELOAD=true

# CORS — comma-separated origins; use * for mobile clients
ALLOWED_ORIGINS=*

# Wiktionary fallback
WIKTIONARY_TIMEOUT=5.0

# Supabase (optional — reserved for future protected endpoints)
# SUPABASE_URL / needed
# SUPABASE_JWT_SECRET / needed
